<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS for pacifictours.triviio.com.
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Serve existing files/folders from /public without showing /public in URL.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Send all other requests to Laravel's front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>
